# Backend Environment Configuration for AWS EC2 Deployment

# Server Network Settings
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Application Security
# 32-byte (256-bit) Hex Key used for AES-256-GCM encryption
SECURE_BANKING_AES_KEY=4f8a9b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a

# Database Connection (SQLite database file stored in backend folder)
DATABASE_URL=sqlite:///./banking_simulation.db

# Environment Mode
ENVIRONMENT=production
