# Frontend Environment Configuration for AWS EC2 Deployment

# When using Nginx reverse proxy (Recommended):
# Nginx proxies all requests from /api to http://127.0.0.1:8000/api
VITE_API_BASE_URL=/api

# If NOT using Nginx and running backend directly on public port 8000,
# uncomment and set your EC2 public IP:
# VITE_API_BASE_URL=http://<YOUR_EC2_PUBLIC_IP>:8000/api
